# Database Driver: "sqlite" or "mysql"
DB_DRIVER=sqlite

# SQLite Configuration (relative to php_backend or absolute path)
DB_FILE=data/database.sqlite

# MySQL Configuration (used if DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quantum_platform
DB_USER=root
DB_PASS=

# CORS Settings
CORS_ORIGIN=*

# JWT / Secret Key for Token Signing
JWT_SECRET=super_secret_quantum_platform_key_2026
